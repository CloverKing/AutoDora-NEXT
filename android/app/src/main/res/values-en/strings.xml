    <string name="guide_title">Floating Capsule Guide</string>
    <string name="guide_line_1">• \"Solve\" scans &amp; previews paths; \"◀ / ▶\" switches candidates; \"Go\" executes (or Hold-Replan when toggled ON).</string>
